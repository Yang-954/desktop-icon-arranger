{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面图标排列器",
  "version": "3.0.0",
  "identifier": "com.yang954.desktopiconarranger",
  "build": {
    "frontendDist": "web-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "桌面图标排列器 · Rust 版",
        "width": 1260,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "app_icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}